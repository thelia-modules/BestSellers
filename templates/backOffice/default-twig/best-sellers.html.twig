{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Best sellers'|trans({}, 'bestsellers.bo.default') }}{% endblock %}

{% block body_testid %}best-sellers-page{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-1">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Best sellers'|trans({}, 'bestsellers.bo.default') }}</li>
        </ol>
    </nav>
{% endblock %}

{% set base_query = {'startDate': startDate, 'endDate': endDate} %}

{% block content %}
    <div class="container-fluid">
        <div class="bo-page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
            <h1 class="h4 mb-0 d-flex align-items-center gap-2">
              {{ 'Best sellers'|trans({}, 'bestsellers.bo.default') }}
            </h1>

            <form class="d-flex flex-wrap align-items-end gap-2 bo-page-header__actions" action="{{ path('bestsellers.admin.list') }}" method="GET">
                <input type="hidden" name="order" value="{{ order }}">

                <div>
                    <label class="form-label" for="start-date">{{ 'View from : '|trans({}, 'bestsellers.bo.default') }}</label>
                    <input id="start-date" class="form-control" name="startDate" value="{{ startDate }}" type="date">
                </div>

                <div>
                    <label class="form-label" for="end-date">{{ ' to : '|trans({}, 'bestsellers.bo.default') }}</label>
                    <input id="end-date" class="form-control" name="endDate" value="{{ endDate }}" type="date">
                </div>

                <button type="submit" class="btn btn-primary">{{ 'View'|trans({}, 'bestsellers.bo.default') }}</button>
            </form>
        </div>

        {% set table_rows = [] %}
        {% for row in rows %}
            {% set product_url = '/admin/products/update?product_id=' ~ row.id %}
            {% set table_rows = table_rows|merge([{
                'ref':      '<a href="' ~ product_url ~ '">' ~ row.ref|e ~ '</a>',
                'title':    '<a href="' ~ product_url ~ '">' ~ row.title|e ~ '</a>',
                'quantity': row.quantity|round,
                'amount':   row.amount|number_format(2, '.', ' '),
                'ratio':    row.ratio|number_format(2, '.', '') ~ ' %',
            }]) %}
        {% endfor %}

        {{ component('BoDataTable', {
            id: 'best-sellers',
            columns: [
                column_html('ref',      'Product reference'|trans({}, 'bestsellers.bo.default')),
                column_html('title',    'Product title'|trans({}, 'bestsellers.bo.default')),
                column_text('quantity', 'Sales total'|trans({}, 'bestsellers.bo.default'),  'end'),
                column_text('amount',   'Total amount'|trans({}, 'bestsellers.bo.default'), 'end'),
                column_text('ratio',    'Sale ratio'|trans({}, 'bestsellers.bo.default'),   'end'),
            ],
            rows: table_rows,
            emptyMessage: 'You have not sold any products yet'|trans({}, 'bestsellers.bo.default'),
        }) }}

        {# Same pager as the Thelia 2 back-office: a window of up to 10 numbers starting 5 pages
           before the current one, « ‹ … › » buttons, disabled at the ends. #}
        {% if pageCount > 0 %}
            {% set window_size = 10 %}
            {% set first_shown = pageCount > window_size ? max(1, page - 5) : 1 %}
            {% set last_shown = min(first_shown + window_size - 1, pageCount) %}
            {% set link_params = base_query|merge({'order': order}) %}
            <nav class="mt-4" aria-label="{{ 'Pagination'|trans }}" data-testid="best-sellers-pagination">
                <ul class="pagination justify-content-center flex-wrap mb-0">
                    {% if page > 1 %}
                        <li class="page-item"><a class="page-link" title="{{ 'Go to first page'|trans }}" href="{{ path('bestsellers.admin.list', link_params|merge({'page': 1})) }}">&laquo;</a></li>
                        <li class="page-item"><a class="page-link" title="{{ 'Go to previous page'|trans }}" href="{{ path('bestsellers.admin.list', link_params|merge({'page': page - 1})) }}">&lsaquo;</a></li>
                        {% if first_shown > 1 %}
                            <li class="page-item disabled" title="{{ 'More pages before'|trans }}"><span class="page-link">&hellip;</span></li>
                        {% endif %}
                    {% else %}
                        <li class="page-item disabled"><span class="page-link">&laquo;</span></li>
                        <li class="page-item disabled"><span class="page-link">&lsaquo;</span></li>
                    {% endif %}

                    {% for number in first_shown..last_shown %}
                        {% if number == page %}
                            <li class="page-item active" aria-current="page"><span class="page-link">{{ number }}</span></li>
                        {% else %}
                            <li class="page-item"><a class="page-link" href="{{ path('bestsellers.admin.list', link_params|merge({'page': number})) }}">{{ number }}</a></li>
                        {% endif %}
                    {% endfor %}

                    {% if page < pageCount %}
                        {% if last_shown < pageCount and pageCount > window_size %}
                            <li class="page-item disabled" title="{{ 'More pages after'|trans }}"><span class="page-link">&hellip;</span></li>
                        {% endif %}
                        <li class="page-item"><a class="page-link" title="{{ 'Go to next page'|trans }}" href="{{ path('bestsellers.admin.list', link_params|merge({'page': page + 1})) }}">&rsaquo;</a></li>
                        <li class="page-item"><a class="page-link" title="{{ 'Go to last page'|trans }}" href="{{ path('bestsellers.admin.list', link_params|merge({'page': pageCount})) }}">&raquo;</a></li>
                    {% else %}
                        <li class="page-item disabled"><span class="page-link">&rsaquo;</span></li>
                        <li class="page-item disabled"><span class="page-link">&raquo;</span></li>
                    {% endif %}
                </ul>
            </nav>
        {% endif %}
    </div>
{% endblock %}
