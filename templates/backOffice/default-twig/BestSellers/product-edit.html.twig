{# Best-sellers statistics block, shown on the product edit screen (hook product-edit.bottom) #}
{% if stats is not null %}
    <div class="card mb-3">
        <div class="card-header">
            <h3 class="card-title mb-0">{{ 'Statistics'|trans({}, 'bestsellers.bo.default') }}</h3>
        </div>
        <div class="card-body">
            <ul class="mb-0">
                <li>{{ 'Total sales for this product: <strong>%count</strong>'|trans({'%count': stats.quantity|round}, 'bestsellers.bo.default')|raw }}</li>
                <li>{{ 'Sold amount for this product: <strong>%count</strong>'|trans({'%count': stats.amount|number_format(2, '.', ' ')}, 'bestsellers.bo.default')|raw }}</li>
                <li>{{ '% of sales: <strong>%count%</strong>'|trans({'%count': stats.ratio|number_format(2, '.', '')}, 'bestsellers.bo.default')|raw }}</li>
            </ul>
        </div>
    </div>
{% endif %}
