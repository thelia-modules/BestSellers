{# Best-sellers statistics block, shown on the product edit screen (hook product-edit.bottom) #}
{% if stats is not null %}
    <div class="card mb-3">
        <div class="card-header">
            <h3 class="card-title mb-0">{{ 'Statistics'|trans({}, 'bestsellers.bo.default') }}</h3>
        </div>
        <div class="card-body">
            <ul class="mb-0">
                <li>{{ 'Total sales for this product:'|trans({}, 'bestsellers.bo.default') }} <strong>{{ stats.quantity|round }}</strong></li>
                <li>{{ 'Sold amount for this product:'|trans({}, 'bestsellers.bo.default') }} <strong>{{ stats.amount|number_format(2, '.', ' ') }}</strong></li>
                <li>{{ '% of sales:'|trans({}, 'bestsellers.bo.default') }} <strong>{{ stats.ratio|number_format(2, '.', '') }}%</strong></li>
            </ul>
        </div>
    </div>
{% endif %}
