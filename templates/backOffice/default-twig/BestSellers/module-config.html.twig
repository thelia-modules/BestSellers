{# BestSellers module configuration (hook module.configuration, default-twig BO) #}
<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title mb-0">{{ 'Order types and dates'|trans({}, 'bestsellers.bo.default') }}</h3>
    </div>
    <div class="card-body">
        {{ form_start(form, {'action': '/admin/module/bestsellers/config', 'method': 'POST', 'attr': {'data-controller': 'bestsellers-config'}}) }}
            {{ form_errors(form) }}

            <div class="mb-3 col-md-4">
                {{ form_label(form.order) }}
                {{ form_widget(form.order) }}
                {{ form_errors(form.order) }}
                <span class="form-text">
                    {{ 'Enter the IDs of order status you wish to be taken into account for your bestsellers statistics (eg: 2,3,4)'|trans({}, 'bestsellers.bo.default') }}
                </span>
            </div>

            <div class="mb-3 col-md-4">
                <label class="form-label" for="{{ form.date_type.vars.id }}">{{ 'Choose a date type : '|trans({}, 'bestsellers.bo.default') }}</label>
                {{ form_widget(form.date_type, {'attr': {'data-bestsellers-config-target': 'dateType', 'data-action': 'change->bestsellers-config#toggle'}}) }}
                {{ form_errors(form.date_type) }}
            </div>

            <div class="mb-3 col-md-4" data-bestsellers-config-target="fixedDates">
                <label class="form-label" for="{{ form.start_date.vars.id }}">{{ 'Choose a start date : '|trans({}, 'bestsellers.bo.default') }}</label>
                {{ form_widget(form.start_date) }}
                {{ form_errors(form.start_date) }}
                <label class="form-label mt-2" for="{{ form.end_date.vars.id }}">{{ 'Choose an end date : '|trans({}, 'bestsellers.bo.default') }}</label>
                {{ form_widget(form.end_date) }}
                {{ form_errors(form.end_date) }}
            </div>

            <div class="mb-3 col-md-4" data-bestsellers-config-target="dateRange">
                <label class="form-label" for="{{ form.date_range.vars.id }}">{{ 'Choose a date range : '|trans({}, 'bestsellers.bo.default') }}</label>
                {{ form_widget(form.date_range) }}
                {{ form_errors(form.date_range) }}
            </div>

            <div class="mb-3 col-md-4">
                <label class="form-label" for="{{ form.order_by.vars.id }}">{{ 'Order by'|trans({}, 'bestsellers.bo.default') }}</label>
                {{ form_widget(form.order_by) }}
                {{ form_errors(form.order_by) }}
            </div>

            <button type="submit" class="btn btn-primary">{{ 'Set'|trans({}, 'bestsellers.bo.default') }}</button>
        {{ form_end(form) }}

        <hr>

        {% set table_rows = [] %}
        {% for status in order_statuses %}
            {% set status_url = '/admin/configuration/order-status/update/' ~ status.id %}
            {% set table_rows = table_rows|merge([{
                'id':       '<a href="' ~ status_url ~ '">' ~ status.id|e ~ '</a>',
                'code':     '<a href="' ~ status_url ~ '">' ~ status.code|e ~ '</a>',
                'title':    '<a class="badge text-decoration-none" style="background-color: ' ~ (status.color ? status.color : '#f0ad4e')|e ~ ';" href="' ~ status_url ~ '">' ~ status.title|e ~ '</a>',
                'orders':   '<a href="/admin/orders?status=' ~ status.id|e ~ '">' ~ status.orders|e ~ '</a>',
                'position': status.position,
            }]) %}
        {% endfor %}

        {{ component('BoDataTable', {
            id: 'order-statuses',
            caption: 'Order status'|trans({}, 'bestsellers.bo.default'),
            columns: [
                column_html('id',       'Id'|trans({}, 'bestsellers.bo.default')),
                column_html('code',     'Code'|trans({}, 'bestsellers.bo.default')),
                column_html('title',    'Title'|trans({}, 'bestsellers.bo.default')),
                column_html('orders',   'Orders'|trans({}, 'bestsellers.bo.default')),
                column_text('position', 'Position'|trans({}, 'bestsellers.bo.default')),
            ],
            rows: table_rows,
            emptyMessage: 'No order status defined.'|trans({}, 'bestsellers.bo.default'),
        }) }}
    </div>
</div>

<script>
    (function () {
        const root = document.querySelector('[data-controller="bestsellers-config"]');
        if (!root) {
            return;
        }
        const dateType = root.querySelector('[data-bestsellers-config-target="dateType"]');
        const fixedDates = root.querySelector('[data-bestsellers-config-target="fixedDates"]');
        const dateRange = root.querySelector('[data-bestsellers-config-target="dateRange"]');

        function toggle() {
            if (fixedDates) { fixedDates.style.display = 'none'; }
            if (dateRange) { dateRange.style.display = 'none'; }
            if (dateType.value === '2' && dateRange) {
                dateRange.style.display = 'block';
            } else if (dateType.value === '1' && fixedDates) {
                fixedDates.style.display = 'block';
            }
        }

        dateType.addEventListener('change', toggle);
        toggle();
    })();
</script>
